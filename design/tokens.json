{
  "name": "certification-study-lab",
  "description": "Tailwind-ready design tokens for a focused, accessible certification study experience.",
  "palette": {
    "orange": "#FF9F1C",
    "peach": "#FFBF69",
    "white": "#FFFFFF",
    "aqua": "#CBF3F0",
    "teal": "#2EC4B6"
  },
  "color": {
    "brand": {
      "primary": "#2EC4B6",
      "primaryHover": "#FF9F1C",
      "accent": "#FF9F1C",
      "highlight": "#FFBF69"
    },
    "surface": {
      "canvas": "#FFFFFF",
      "raised": "#FFFFFF",
      "subtle": "#CBF3F0",
      "highlight": "#FFBF69"
    },
    "text": {
      "primary": "#111111",
      "secondary": "#111111",
      "inverse": "#FFFFFF"
    },
    "feedback": {
      "correct": "#2EC4B6",
      "correctSurface": "#CBF3F0",
      "review": "#FF9F1C",
      "reviewSurface": "#FFBF69"
    },
    "border": {
      "default": "#2EC4B6",
      "strong": "#FF9F1C",
      "focus": "#FF9F1C"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"
    },
    "fontSize": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "md": "1rem",
      "lg": "1.125rem",
      "xl": "1.5rem",
      "display": "2.25rem"
    },
    "lineHeight": {
      "tight": 1.2,
      "normal": 1.5,
      "relaxed": 1.7
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "space": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "6": "1.5rem",
    "8": "2rem",
    "12": "3rem",
    "16": "4rem"
  },
  "radius": {
    "sm": "0.375rem",
    "md": "0.625rem",
    "lg": "1rem",
    "pill": "999px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(24, 49, 61, 0.08)",
    "md": "0 8px 24px rgba(24, 49, 61, 0.12)"
  },
  "motion": {
    "fast": "120ms",
    "normal": "200ms",
    "ease": "cubic-bezier(0.2, 0.8, 0.2, 1)"
  }
}
